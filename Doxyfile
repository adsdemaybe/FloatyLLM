# Doxygen config for FloatyLLM call/dependency graph generation (CUDA-aware).
# Only non-default settings are set; Doxygen fills the rest.
# Generate with: tools/codegraph.sh   (needs doxygen + graphviz)

PROJECT_NAME      = "FloatyLLM"
OUTPUT_DIRECTORY  = build/codegraph
INPUT             = src
RECURSIVE         = YES
FILE_PATTERNS     = *.cu *.cuh *.cpp *.cc *.cxx *.c *.h *.hpp *.hh
EXTENSION_MAPPING = cu=C++ cuh=C++

# Extract everything, including undocumented + static, so the graph is complete.
EXTRACT_ALL       = YES
EXTRACT_STATIC    = YES
EXTRACT_PRIVATE   = YES

# Graphs (require Graphviz `dot`).
HAVE_DOT            = YES
CALL_GRAPH         = YES
CALLER_GRAPH       = YES
INCLUDE_GRAPH      = YES
INCLUDED_BY_GRAPH  = YES
DIRECTORY_GRAPH    = YES
GRAPHICAL_HIERARCHY = YES
DOT_IMAGE_FORMAT   = svg
INTERACTIVE_SVG    = YES
DOT_GRAPH_MAX_NODES = 200
DOT_MULTI_TARGETS  = YES

# Output.
GENERATE_HTML     = YES
GENERATE_LATEX    = NO
QUIET             = YES
WARN_IF_UNDOCUMENTED = NO
